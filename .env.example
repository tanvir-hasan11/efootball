# PostgreSQL connection string used by Prisma
# The project uses a local PostgreSQL cluster on port 5433 (see scripts/db-start.bat)
DATABASE_URL="postgresql://efootball:efootball@localhost:5433/efootball?schema=public"

# Secret used to sign Auth.js session cookies.
# Generate one with: `openssl rand -base64 32`
AUTH_SECRET="change-me-to-a-long-random-string"
